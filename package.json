{
	"name": "simple-procesador-facturas",
	"version": "0.2.0",
	"description": "Sistema automatizado para procesamiento, extracción y gestión de facturas argentinas con reconocimiento OCR y aprendizaje de patrones",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": ".githooks/install.sh 2>/dev/null || echo '⚠️  Nota: No se pudieron instalar git hooks'",
		"dev": "cd client && npm run dev",
		"dev:hono": "cd server && npm run dev:hono",
		"build": "npm run check && ( cd client && npm run build )",
		"check": "tsc -b shared && tsc -b server/tsconfig.json --dry && ( cd client && npm run check )",
		"preview": "cd client && npm run preview",
		"test": "cd server && npm run test",
		"test:coverage": "cd server && npm run test:coverage",
		"debug:qr": "tsx scripts/debug/qr/extract.ts",
		"debug:qr:raw": "tsx scripts/debug/qr/raw.ts",
		"debug:qr:scales": "tsx scripts/debug/qr/scales.ts",
		"debug:qr:preprocess": "tsx scripts/debug/qr/preprocess.ts",
		"debug:qr:crop-arca": "tsx scripts/debug/qr/crop-arca.ts",
		"debug:qr:benchmark": "tsx scripts/debug/qr/benchmark.ts",
		"lint": "cd server && npm run lint",
		"format": "( cd client && npm run format ) && ( cd server && npm run format )",
		"format:check": "( cd client && npm run format:check ) && ( cd server && npm run format:check )",
		"ci:check": "./scripts/ci-check.sh",
		"db:migrate": "cd server && npm run db:migrate",
		"db:seed": "cd server && npm run db:seed",
		"db:studio": "cd server && npm run db:studio",
		"backfill-hashes": "tsx server/scripts/backfill-hashes.ts",
		"reset": "./scripts/reset-dev-env.sh",
		"docker:build": "docker-compose build",
		"docker:up": "docker-compose up -d",
		"docker:down": "docker-compose down",
		"docker:logs": "docker-compose logs -f"
	},
	"keywords": [
		"facturas",
		"ocr",
		"pdf",
		"argentina",
		"afip",
		"cuit",
		"invoice",
		"processing",
		"automation"
	],
	"author": "",
	"license": "MIT",
	"engines": {
		"node": ">=22.21.0",
		"npm": ">=10.0.0"
	},
	"workspaces": [
		"client",
		"server"
	],
	"dependencies": {
		"drizzle-orm": "1.0.0-beta.15-859cf75"
	},
	"devDependencies": {
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0"
	}
}
