#!/bin/bash
# Pre-commit hook: Formatear código y validar archivos antes de commitear

set -e

# Auto-formatear archivos TypeScript y Svelte con Prettier
echo "🎨 Formateando código con Prettier..."

# Obtener archivos .ts y .svelte en staging (excluyendo node_modules)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|svelte)$' | grep -v 'node_modules' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "📝 Formateando archivos TypeScript y Svelte:"
  echo "$STAGED_FILES" | sed 's/^/  - /'

  # Routear cada archivo al prettier del workspace correspondiente.
  # Bajo Bun el root node_modules/.bin no tiene los bins hoisteados de workspaces,
  # y client/.prettierrc requiere prettier-plugin-svelte que solo vive en client/.
  # Importante: hay que `cd` al workspace para que prettier resuelva sus plugins,
  # caso contrario el resolver sube al root y no encuentra prettier-plugin-svelte.
  CLIENT_FILES=$(echo "$STAGED_FILES" | grep '^client/' | sed 's|^client/||' || true)
  OTHER_FILES=$(echo "$STAGED_FILES" | grep -v '^client/' || true)

  if [ -n "$CLIENT_FILES" ]; then
    (cd client && echo "$CLIENT_FILES" | xargs ./node_modules/.bin/prettier --write)
  fi
  if [ -n "$OTHER_FILES" ]; then
    echo "$OTHER_FILES" | xargs ./server/node_modules/.bin/prettier --write
  fi

  # Re-agregar archivos formateados al staging
  echo "$STAGED_FILES" | xargs git add

  echo "✅ Archivos formateados"
else
  echo "✅ No hay archivos TypeScript o Svelte para formatear"
fi

echo ""
echo "🔍 Validando archivos Svelte..."

# Obtener archivos .svelte en staging
SVELTE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.svelte$' || true)

if [ -z "$SVELTE_FILES" ]; then
  echo "✅ No hay archivos .svelte para validar"
  exit 0
fi

echo "📝 Archivos a validar:"
echo "$SVELTE_FILES" | sed 's/^/  - /'

# Validar sintaxis básica con grep
echo ""
echo "🔎 Verificando sintaxis básica..."

ERRORS=0
while IFS= read -r file; do
  # Verificar errores comunes
  if grep -n '<\/[a-z]*}' "$file" > /dev/null 2>&1; then
    echo "❌ Error en $file: etiqueta de cierre con } en lugar de >"
    grep -n '<\/[a-z]*}' "$file"
    ERRORS=$((ERRORS + 1))
  fi

  if grep -n '{\/if}' "$file" > /dev/null 2>&1; then
    echo "⚠️  Advertencia en $file: posible error en bloque {/if}"
  fi
done <<< "$SVELTE_FILES"

if [ $ERRORS -gt 0 ]; then
  echo ""
  echo "❌ Se encontraron $ERRORS error(es) de sintaxis."
  echo "   Por favor, corregalos antes de commitear."
  exit 1
fi

# Validación TypeScript estricta (igual que CI)
echo ""
echo "🔬 Validando TypeScript y Svelte (client)..."
if ! (cd client && npx svelte-check --fail-on-warnings --threshold error); then
  echo ""
  echo "❌ Errores de TypeScript/Svelte en client/"
  echo "   Usá 'git commit --no-verify' para saltear esta validación (no recomendado)"
  exit 1
fi

echo ""
echo "🔬 Validando TypeScript (server)..."
if ! (cd server && npx tsc --noEmit); then
  echo ""
  echo "❌ Errores de TypeScript en server/"
  echo "   Usá 'git commit --no-verify' para saltear esta validación (no recomendado)"
  exit 1
fi

echo ""
echo "✅ Validación completada"
exit 0
