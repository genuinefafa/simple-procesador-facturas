# Configuración para Docker Compose
# Copiar este archivo a .env antes de ejecutar docker-compose up

# Puerto de la aplicación (mapeado desde el host)
APP_PORT=3000

# Modo de ejecución
NODE_ENV=production

# CUIT de la empresa que gestiona la app (11 dígitos, se aceptan guiones).
# Si está definido, se rechazan los Excel de Mis Comprobantes de otro CUIT.
# Valor de prueba, reemplazar por el real.
COMPANY_CUIT=30123456789
